{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?__path=/:path*" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "src/**",
        "public/**",
        "data.json",
        "node_modules/@tonconnect/ui/dist/tonconnect-ui.min.js"
      ]
    }
  }
}
