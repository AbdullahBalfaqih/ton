# Telegram BotFather token and public bot username (without @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Qatta_Bot
# Set a random 1-256 character secret and configure Telegram webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Local development only: use polling instead of requiring a public webhook URL
BOT_POLLING=1
PORT=3000
# Public HTTPS origin for TON Connect manifest and organizer /connect links (required in production)
PUBLIC_BASE_URL=

# USD amounts are converted using a live price quote at checkout.
TON_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=the-open-network&vs_currencies=usd
# TON Center v2 reads real finalized account transactions; key is optional but recommended.
TONCENTER_API_URL=https://toncenter.com/api/v2/getTransactions
TONCENTER_API_KEY=
